rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles & settings (private to the user)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Student curriculum progress & analytics
    match /student_progress/{progressDocId} {
      allow read, write: if true;
    }

    // Diagnostic quiz score submissions and history
    match /quiz_attempts/{attemptId} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // AI Tutor query logs & bookmarks
    match /ai_tutor_history/{historyId} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Admission inquiries & Demo applications (Public read & create for inbox access, authenticated for updates/deletes)
    match /admission_inquiries/{inquiryId} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Contact & Helpline messages (Public read & create for inbox access, authenticated for updates/deletes)
    match /contact_messages/{messageId} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Default rule for other collections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}

